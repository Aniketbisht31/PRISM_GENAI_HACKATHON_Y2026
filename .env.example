# LLM Backend: "ollama" (local) or "groq" (cloud)
LLM_BACKEND=ollama

# Groq API Key (required if LLM_BACKEND=groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional remote-model cost-rate overrides (USD per 1M tokens).
# GPT-OSS 20B on Groq uses published defaults when these are blank.
# Set both when using a different remote model/provider.
LLM_PROMPT_COST_PER_1M_TOKENS_USD=
LLM_COMPLETION_COST_PER_1M_TOKENS_USD=

# Ollama host and installed model (used if LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

# Embedding model (local, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB persistence path
CHROMA_PERSIST_DIR=./data/chroma_index

# Telemetry output path
TELEMETRY_LOG_PATH=./data/telemetry.jsonl

# API settings
API_HOST=0.0.0.0
API_PORT=8000
